# Application
NODE_ENV=development
PORT=3000

# Database - PostgreSQL con Prisma
# IMPORTANTE: Usa @localhost cuando la app corre localmente
# IMPORTANTE: Usa @postgres cuando la app corre en Docker Compose
DATABASE_URL="postgresql://nestjs_user:nestjs_password@localhost:5432/nestjs_hexagonal_db?schema=public"

# Database components (para docker-compose)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=nestjs_user
DATABASE_PASSWORD=nestjs_password
DATABASE_NAME=nestjs_hexagonal_db

# Prisma
# PRISMA_QUERY_LOG=true  # Descomentar para ver queries SQL en desarrollo

# PgAdmin (opcional)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# API Keys
# JWT_SECRET=your-jwt-secret-here

# Context7 MCP Server (optional)
CONTEXT7_API_KEY=your-context7-api-key-here

# Logging
LOG_LEVEL=debug

# CORS
# CORS_ORIGIN=http://localhost:3000
